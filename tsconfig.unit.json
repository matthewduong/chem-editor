{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".unit-test-dist",
    "rootDir": ".",
    "isolatedModules": false,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/editor/**/*.ts",
    "src/store/index.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "src/lib/fileDialogs.ts",
    "src/lib/tauri.ts",
    "src/lib/documentRecovery.ts",
    "src/lib/cdxmlWorkerClient.ts",
    "src/lib/chemdrawDocumentCommandsAsync.ts"
  ]
}
