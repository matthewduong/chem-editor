{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChemEditor",
  "version": "0.1.0",
  "identifier": "com.mrd.chem-editor",
  "build": {
    "beforeDevCommand": "node scripts/prepare-tauri-dev.mjs",
    "beforeBuildCommand": "node scripts/prepare-tauri-build.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChemEditor",
        "width": 800,
        "height": 600,
        "decorations": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; font-src 'self' data:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/chem-engine-*/**/*",
      "bin/nmr_refs.json",
      "bin/nmr_hose_db.sqlite",
      "bin/xtb*",
      "bin/xtb-share/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
