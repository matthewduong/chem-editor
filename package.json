{
  "name": "chem-editor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "dependencies": {
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "konva": "^10.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "three": "0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vite-plugin-eslint2": "^5.1.0",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "predev": "node scripts/copy-rdkit.mjs",
    "dev": "pnpm tauri dev",
    "dev:web": "vite",
    "sync:sidecar": "node src-tauri/build-sidecar.js",
    "build:sidecar": "node src-tauri/build-sidecar.js",
    "build:web": "tsc && vite build",
    "build:app": "pnpm tauri:build",
    "build": "pnpm build:app",
    "preview": "vite preview",
    "pretauri": "pnpm sync:sidecar",
    "tauri": "tauri",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "lint:js": "pnpm typecheck && eslint src tests scripts src-tauri/build-sidecar.js",
    "lint:format": "prettier --check .",
    "lint:py": "uvx ruff check development/build_nmr_hose_db.py development/precompute_nmr_refs.py development/src_tauri_path.py src-tauri/bin/chem-engine.py src-tauri/bin/nmr_hose.py src-tauri/tests/test_nmr_hose.py",
    "lint:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:py": "uvx ruff format development/build_nmr_hose_db.py src-tauri/bin/ src-tauri/tests/",
    "fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:js": "prettier --write .",
    "fmt": "pnpm fmt:js && pnpm fmt:py && pnpm fmt:rs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node scripts/run-all-tests.mjs",
    "test:all": "node scripts/run-all-tests.mjs",
    "test:js": "node scripts/run-unit-tests.mjs",
    "test:js:ui": "vitest run --config vitest.config.ts",
    "test:chemdraw:mac": "node scripts/run-chemdraw-tests.mjs smoke",
    "test:chemdraw:mac:private": "node scripts/run-chemdraw-tests.mjs full",
    "test:py": "node scripts/run-python-tests.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:unit": "pnpm test:js",
    "lint": "pnpm lint:js && pnpm lint:format && pnpm lint:py && pnpm lint:rs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "clean": "node scripts/clean.mjs"
  }
}
