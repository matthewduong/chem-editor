<?xml version="1.0" encoding="UTF-8"?>
<!--
  Same heteroatoms as atom-labels but with implicit hydrogens suppressed. SVG export ignores
  showHydrogens entirely, so this pair is what will prove that divergence is fixed.
-->
<CDXML BondLength="14.4" BondSpacing="18" LineWidth="0.6" BoldWidth="2" MarginWidth="1.6" HashSpacing="2.5" LabelSize="10">
  <page id="page-1">
    <fragment id="f1">
      <n id="1" p="0 0" Element="6"/>
      <n id="2" p="14.4 0" Element="8"/>
      <b id="3" B="1" E="2" Order="1"/>
    </fragment>
    <fragment id="f2">
      <n id="4" p="0 20" Element="6"/>
      <n id="5" p="14.4 20" Element="7"/>
      <b id="6" B="4" E="5" Order="1"/>
    </fragment>
  </page>
</CDXML>
