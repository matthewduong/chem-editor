<?xml version="1.0" encoding="UTF-8"?>
<!--
  Text boxes, and where their line breaks come from.

  A ChemDraw BoundingBox measures text that has already been laid out; it is not a wrapping
  constraint. Wrapping to it would reflow authored text against our metrics rather than ChemDraw's,
  and because the fit is tight the last character spills onto a line of its own.

  LineStarts is where ChemDraw actually records its breaks: the character offset at which each line
  after the first begins, ending with a sentinel at the total length. A break sometimes carries a
  literal newline too and sometimes does not, so the offsets are the authority and a newline sitting
  at one is dropped rather than breaking the line twice.

  t2 is the important case: its box is tight around one long line, exactly as ChemDraw writes it,
  and it must stay on one line. t5 carries both a newline and the matching offsets, and must come
  out as two lines rather than four. t6 uses the private attribute we write for boxes sized in this
  editor, which is the only thing that wraps by measurement. t7 is a caption ChemDraw wrapped, where
  the offsets are the only record of the breaks.
-->
<CDXML BondLength="14.4" LineWidth="0.6" CaptionSize="10">
  <page id="page-1">
    <fonttable>
      <font id="3" charset="iso-8859-1" name="Arial"/>
      <font id="4" charset="iso-8859-1" name="Times New Roman"/>
    </fonttable>
    <t id="t1" p="0 20">
      <s font="3" size="10" face="0">unbounded caption</s>
    </t>
    <t id="t2" p="0 30" BoundingBox="0 24 60 60">
      <s font="3" size="10" face="0">a bounded caption that has to wrap onto several lines</s>
    </t>
    <t id="t3" p="0 90" Justification="Left">
      <s font="3" size="10" face="1">bold</s>
      <s font="3" size="10" face="2">italic</s>
      <s font="3" size="10" face="3">bold italic</s>
    </t>
    <t id="t4" p="0 110">
      <s font="4" size="12" face="0">serif caption</s>
    </t>
    <t id="t5" p="0 140" BoundingBox="0 134 30 160" LineStarts="5 8" Justification="Center">
      <s font="3" size="10" face="0">PIDA
68%</s>
    </t>
    <t id="t6" p="0 180" BoundingBox="0 174 60 210" ChemEditorTextWrapWidth="60">
      <s font="3" size="10" face="0">an editor sized box that really does wrap</s>
    </t>
    <t id="t7" p="0 220" BoundingBox="0 214 200 240" LineStarts="10 21" Justification="Center">
      <s font="3" size="10" face="0">wrapped by ChemDraw, recorded only as offsets</s>
    </t>
  </page>
</CDXML>
