      <b id="6" B="3" E="4"/>
      <b id="7" B="4" E="5"/>
    </fragment>
    <altgroup id="10" GroupFrame="50 -20 150 30" TextFrame="50 -20 75 30" Valence="1">
      <t id="11" p="55 5"><s font="3" size="10" face="96">R1 =</s></t>
      <fragment id="12">
        <n id="13" p="90 0" Element="8"/>
