Windows Registry Editor Version 5.00
; UNTESTED. Registers the CDXML thumbnail handler for the current user. Replace the DLL path
; with the installed chem_editor_thumbnail.dll (next to ChemEditor.exe), then restart Explorer.

[HKEY_CURRENT_USER\Software\Classes\CLSID\{6F2E3A5C-1B7D-4C2E-9A61-0C5D8E7F4B21}]
@="ChemEditor CDXML Thumbnail"

[HKEY_CURRENT_USER\Software\Classes\CLSID\{6F2E3A5C-1B7D-4C2E-9A61-0C5D8E7F4B21}\InprocServer32]
@="C:\\Program Files\\ChemEditor\\chem_editor_thumbnail.dll"
"ThreadingModel"="Apartment"

[HKEY_CURRENT_USER\Software\Classes\.cdxml\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}]
@="{6F2E3A5C-1B7D-4C2E-9A61-0C5D8E7F4B21}"
